# Copia este ficheiro para ".env.local" e preenche com os valores do teu projeto Supabase
# (Project Settings > API). Nunca commites o .env.local (já está no .gitignore).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=coloca-aqui-a-anon-ou-publishable-key

# Service role key (ou "secret key" nos projetos Supabase mais recentes).
# NUNCA expor no browser — só é usada em Server Actions no servidor (convites, admin).
SUPABASE_SERVICE_ROLE_KEY=coloca-aqui-a-service-role-ou-secret-key

# URL pública onde a app está a correr (usada nos emails de convite/reset de password).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
